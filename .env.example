# IA a usar: gemini (grátis) ou claude (pago)
IA=gemini
# Chave grátis do Gemini (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Opcional: modelo Gemini (padrão: gemini-flash-latest)
# GEMINI_MODEL=
# Chave da API do Claude (https://console.anthropic.com), se IA=claude
ANTHROPIC_API_KEY=
# Opcional: modelo Claude (padrão: claude-opus-5-5; mais barato: claude-haiku-5-5)
# CLAUDE_MODEL=
# Palavra-passe para entrares no painel
PAINEL_SENHA=
# Segredo aleatório para as sessões (ex.: openssl rand -hex 32)
SEGREDO_SESSAO=
# Endereço público do servidor (ex.: https://assistente-ia.onrender.com)
PUBLIC_URL=
# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO=
# Opcional: o teu telemóvel para os SMS (também se define no painel)
NUMERO_NOTIFICACOES=
# Opcional: outra voz Polly do Twilio (padrão: Polly.Ines-Neural, pt-PT)
# TWILIO_VOZ=
